FROM nvcr.io/nvidia/cuda-dl-base:26.04-cuda13.2-devel-ubuntu24.04

ARG UV_VERSION=0.11.14

ENV UV_PYTHON=3.13
ENV UV_PROJECT_ENVIRONMENT=/opt/venv
ENV VIRTUAL_ENV=/opt/venv
ENV UV_LINK_MODE=copy
ENV UV_NO_PROGRESS=1
ENV PATH="/root/.local/bin:/opt/venv/bin:${PATH}"
ENV NO_VCS_VERSION=1

WORKDIR /opt/Voice-Agent

RUN <<EOF bash -ex
apt-get update
apt-get install -y curl git
apt-get clean
rm -rf /var/lib/apt/lists/*
EOF

RUN <<EOF bash -ex
curl -LsSf "https://astral.sh/uv/${UV_VERSION}/install.sh" | sh
uv --version
EOF

COPY pyproject.toml uv.lock README.md LICENSE ./
COPY nemo_voice_agent ./nemo_voice_agent
COPY evaluation ./evaluation
COPY examples ./examples
COPY scripts ./scripts
COPY tests ./tests

RUN uv sync --link-mode copy --locked --all-extras --group test
